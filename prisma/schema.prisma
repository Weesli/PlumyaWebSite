// Prisma Schema for Plumya Minecraft Server

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String        @unique
  password     String
  credits      Int           @default(0)
  role         String        @default("user") // "user" | "admin" | "moderator"
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tickets       Ticket[]
  ticketReplies TicketReply[]
  creditLoads   CreditLoad[]
  payments      Payment[]

  @@map("users")
}

model News {
  id        String   @id @default(cuid())
  title     String
  content   String
  author    String   @default("PlumyaAdmin")
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news")
}

model Ticket {
  id        String        @id @default(cuid())
  userId    String
  username  String
  subject   String
  message   String
  status    String        @default("open") // "open" | "answered" | "closed"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   TicketReply[]

  @@map("tickets")
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  username  String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("ticket_replies")
}

model CoinPackage {
  id        String   @id @default(cuid())
  name      String
  coins     Int
  price     Float
  bonus     Int      @default(0)
  popular   Boolean  @default(false)
  icon      String   @default("Coins")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("coin_packages")
}

model CreditLoad {
  id        String   @id @default(cuid())
  userId    String?
  username  String
  amount    Int
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("credit_loads")
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  packageId     String
  orderId       String   @unique
  amount        Float
  coins         Int
  status        String   @default("pending") // "pending" | "success" | "failed"
  paymentMethod String?
  provider      String   @default("paywant")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model SiteSettings {
  id                      String   @id @default("default")
  showRecentRegistrations Boolean  @default(true)
  showRecentCredits       Boolean  @default(true)
  announcement            String   @default("Plumya Sunucusuna Hoş Geldiniz! 🍇")
  serverIp                String   @default("play.plumya.net")
  serverPort              String   @default("25565")
  maxPlayers              Int      @default(200)
  onlinePlayers           Int      @default(47)
  siteName                String   @default("Plumya Network")
  backgroundImage         String   @default("/plumya-dusk.webp")
  panelOpacity            Int      @default(65)
  showNews                Boolean  @default(true)
  discordServerId         String   @default("")
  discordInviteUrl        String   @default("")
  updatedAt               DateTime @updatedAt

  @@map("site_settings")
}
